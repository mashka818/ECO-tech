// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  subtitle    String?  @db.Text
  area        String?  @db.VarChar(50)
  dimensions  String?  @db.VarChar(50)
  floors      Int      @default(1)
  rooms       Int?
  bathrooms   Int?
  terraces    Int?
  price       Decimal? @db.Decimal(12, 2)
  description String?  @db.Text
  mainImage   String?  @map("main_image") @db.VarChar(500)
  images      String[] @default([]) // Массив путей к изображениям
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Staff {
  id            Int      @id @default(autoincrement())
  fullName      String   @map("full_name") @db.VarChar(255)
  position      String?  @db.VarChar(255)
  imageFilename String   @unique @map("image_filename") @db.VarChar(255)
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("staff_photos")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}
